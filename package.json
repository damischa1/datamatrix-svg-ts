{
  "name": "datamatrix-svg-ts",
  "version": "1.0.2",
  "description": "DataMatrix ECC 200 barcode generator as SVG - TypeScript implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm test && npm run check:package",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "datamatrix",
    "data-matrix",
    "barcode",
    "2d-barcode",
    "svg",
    "ecc200",
    "typescript",
    "esm"
  ],
  "author": "Mika Salminen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damischa1/datamatrix-svg-ts.git"
  },
  "bugs": {
    "url": "https://github.com/damischa1/datamatrix-svg-ts/issues"
  },
  "homepage": "https://github.com/damischa1/datamatrix-svg-ts#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.3",
    "jsdom": "^27.4.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "zxing-wasm": "^3.1.4"
  }
}
